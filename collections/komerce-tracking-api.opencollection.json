{
  "opencollection": "1.0.0",
  "info": {
    "name": "Komerce Payment Service Cost Tracking API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tracking",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Track an airway bill",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.collaborator.komerce.id/user/track/waybill",
            "params": [
              {
                "name": "awb",
                "value": "",
                "type": "query",
                "description": "Airway bill (tracking) number."
              },
              {
                "name": "courier",
                "value": "",
                "type": "query",
                "description": "Courier code."
              },
              {
                "name": "last_phone_number",
                "value": "",
                "type": "query",
                "description": "Last 5 digits of the recipient phone number — required for additional validation by certain couriers including JNE."
              }
            ]
          },
          "docs": "Retrieve real-time shipment status and manifest history for an AWB number from a supported courier."
        },
        {
          "info": {
            "name": "Get airway bill history",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.collaborator.komerce.id/user/order/api/v1/orders/history-airway-bill",
            "params": [
              {
                "name": "shipping",
                "value": "",
                "type": "query",
                "description": "Courier code."
              },
              {
                "name": "airway_bill",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get airway bill history"
        }
      ]
    }
  ],
  "bundled": true
}