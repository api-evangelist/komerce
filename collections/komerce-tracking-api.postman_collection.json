        {
          "id": "cb6d5fc3-4a52-4f8b-beab-f91d6ccc4c5b",
          "name": "Track an airway bill",
          "request": {
            "name": "Track an airway bill",
            "description": {
              "content": "Retrieve real-time shipment status and manifest history for an AWB number from a supported courier.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "track",
                "waybill"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "awb",
                  "value": "<string>",
                  "description": "(Required) Airway bill (tracking) number."
                },
                {
                  "disabled": false,
                  "key": "courier",
                  "value": "<string>",
                  "description": "(Required) Courier code."
                },
                {
                  "disabled": false,
                  "key": "last_phone_number",
                  "value": "<string>",
                  "description": "Last 5 digits of the recipient phone number — required for additional validation by certain couriers including JNE."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null
          },
