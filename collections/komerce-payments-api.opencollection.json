{
  "opencollection": "1.0.0",
  "info": {
    "name": "Komerce Payment Service Cost Payments API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Payments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get payment methods",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.collaborator.komerce.id/user/api/v1/user/methods"
          },
          "docs": "Retrieve available payment methods including Virtual Account banks and QRIS, with bank codes and min/max amounts."
        },
        {
          "info": {
            "name": "Create a payment transaction",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.collaborator.komerce.id/user/api/v1/user/payment/create",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new payment transaction for a Virtual Account bank or QRIS channel."
        },
        {
          "info": {
            "name": "Get payment status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.collaborator.komerce.id/user/api/v1/user/payment/status/:payment_id",
            "params": [
              {
                "name": "payment_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get payment status"
        },
        {
          "info": {
            "name": "Cancel a Virtual Account payment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.collaborator.komerce.id/user/api/v1/user/payment/cancel",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Cancel a Virtual Account payment"
        }
      ]
    }
  ],
  "bundled": true
}