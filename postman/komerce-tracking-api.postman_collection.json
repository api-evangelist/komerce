{
  "info": {
    "_postman_id": "d744fb3a-0b39-435f-a46c-2b310f777697",
    "name": "Komerce Payment Service Cost Tracking API",
    "description": "Komerce Payment Service API \u2014 list payment methods (bank Virtual Account and QRIS),\ncreate a payment transaction, check payment status, cancel a Virtual Account payment,\nand receive HMAC-SHA256 signed callbacks. Authentication is a header API key\n(`x-api-key`) \u2014 the same key used for Komerce Shipping (RajaOngkir). Hosted payment\npages are served at https://pay.komerce.id/{token} (sandbox: https://pay-sandbox.komerce.id/{token}).\n\n\nContact Support:\n Name: RajaOngkir Support\n Email: support@rajaongkir.com",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T02:00:50.000Z",
    "updatedAt": "2026-07-28T02:00:50.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-d744fb3a-0b39-435f-a46c-2b310f777697"
  },
