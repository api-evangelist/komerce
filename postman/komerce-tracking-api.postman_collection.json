                          "value": "<string>"
                        },
                        {
                          "description": "Last 5 digits of the recipient phone number \u2014 required for additional validation by certain couriers including JNE.",
                          "key": "last_phone_number",
                          "value": "<string>"
                        }
                      ]
                    }
                  },
                  "status": "OK",
                  "code": 200,
                  "_postman_previewlanguage": "json",
                  "header": [
                    {
                      "key": "Content-Type",
                      "value": "application/json"
                    }
                  ],
                  "cookie": [],
                  "responseTime": null,
                  "body": "{\n  \"meta\": {\n    \"message\": \"<string>\",\n    \"code\": \"<integer>\",\n    \"status\": \"<string>\"\n  },\n  \"data\": {\n    \"delivered\": \"<boolean>\",\n    \"summary\": {\n      \"courier_code\": \"<string>\",\n      \"courier_name\": \"<string>\",\n      \"waybill_number\": \"<string>\",\n      \"service_code\": \"<string>\",\n      \"waybill_date\": \"<string>\",\n      \"shipper_name\": \"<string>\",\n      \"receiver_name\": \"<string>\",\n      \"origin\": \"<string>\",\n      \"destination\": \"<string>\",\n      \"status\": \"<string>\"\n    },\n    \"details\": {\n      \"waybill_number\": \"<string>\",\n      \"waybill_date\": \"<string>\",\n      \"waybill_time\": \"<string>\",\n      \"weight\": \"<string>\",\n      \"origin\": \"<string>\",\n      \"destination\": \"<string>\",\n      \"shipper_name\": \"<string>\",\n      \"shipper_address1\": \"<string>\",\n      \"shipper_address2\": \"<string>\",\n      \"shipper_address3\": \"<string>\",\n      \"shipper_city\": \"<string>\",\n      \"receiver_name\": \"<string>\",\n      \"receiver_address1\": \"<string>\",\n      \"receiver_address2\": \"<string>\",\n      \"receiver_address3\": \"<string>\",\n      \"receiver_city\": \"<string>\"\n    },\n    \"delivery_status\": {\n      \"status\": \"<string>\",\n      \"pod_receiver\": \"<string>\",\n      \"pod_date\": \"<string>\",\n      \"pod_time\": \"<string>\"\n    },\n    \"manifest\": [\n      {\n        \"manifest_code\": \"<string>\",\n        \"manifest_description\": \"<string>\",\n        \"manifest_date\": \"<string>\",\n        \"manifest_time\": \"<string>\",\n        \"city_name\": \"<string>\"\n      },\n      {\n        \"manifest_code\": \"<string>\",\n        \"manifest_description\": \"<string>\",\n        \"manifest_date\": \"<string>\",\n        \"manifest_time\": \"<string>\",\n        \"city_name\": \"<string>\"\n      }\n    ]\n  }\n}",
